# OpenRouter is the single gateway for hosted text and image models.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_APP_NAME=LC AI Canvas
# Optional public deployment URL, used only for OpenRouter attribution headers.
OPENROUTER_SITE_URL=
# Keep provider-side data collection denied and require a zero-data-retention route.
OPENROUTER_ZDR=true

# Separate concurrency lane for external API jobs.
OPENROUTER_MAX_CONCURRENT=4
OPENROUTER_MAX_PER_USER_QUEUE=5

# GPT Image 2 may take several minutes for complex edits/reference workflows.
GPT_IMAGE_2_TIMEOUT_SECONDS=300
# Keep the overall job timeout at least 30 seconds longer than the API timeout.
OPENROUTER_JOB_TIMEOUT_SECONDS=330

# Only trust X-Forwarded-For when the request came from one of these proxies.
# Leave empty when the app is reached directly. Example: 10.20.0.0/16,127.0.0.1/32
# Keep Uvicorn proxy-header rewriting disabled; the included launchers already do this.
TRUSTED_PROXY_CIDRS=

# Generation controls. Zero means unlimited/disabled for numeric limits.
GENERATION_ENABLED=true
MCP_GENERATION_ENABLED=true
GENERATION_CONTROL_TIMEZONE=Asia/Seoul
GENERATION_DAILY_REQUEST_LIMIT=0
GENERATION_DAILY_COST_LIMIT_USD=0
GENERATION_COST_CONFIRMATION_THRESHOLD_USD=0
# Optional estimated USD cost map used for reservation/confirmation decisions.
# Keys may be model, model|size, model|quality, model|size|quality, or capability:<name>.
GENERATION_COST_ESTIMATES_JSON={}
