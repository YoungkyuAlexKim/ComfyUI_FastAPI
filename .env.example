# OpenRouter is the single gateway for hosted text and image models.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_APP_NAME=LC AI Canvas
# Optional public deployment URL, used only for OpenRouter attribution headers.
OPENROUTER_SITE_URL=
# Keep provider-side data collection denied and require a zero-data-retention route.
OPENROUTER_ZDR=true

# Separate concurrency lane for external API jobs.
OPENROUTER_MAX_CONCURRENT=4
OPENROUTER_MAX_PER_USER_QUEUE=5

# GPT Image 2 may take several minutes for complex edits/reference workflows.
GPT_IMAGE_2_TIMEOUT_SECONDS=300
# Keep the overall job timeout at least 30 seconds longer than the API timeout.
OPENROUTER_JOB_TIMEOUT_SECONDS=330
